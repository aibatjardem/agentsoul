{
    "name": "@aibatjardem/agentsoul",
    "version": "0.3.0",
    "description": "AgentSoul — Claude Code plugin: soul, language packs and 19 specialist subagents. This package is the build tooling; users install the plugin with /plugin.",
    "type": "module",
    "scripts": {
        "build": "tsc && node tools/dist/cli.js build",
        "typecheck": "tsc --noEmit",
        "test": "tsc && node --test test/*.test.mjs",
        "check": "tsc && node tools/dist/cli.js check"
    },
    "keywords": [
        "claude-code",
        "subagents",
        "ddd",
        "clean-architecture",
        "ai-agents",
        "soul-kit",
        "skills"
    ],
    "author": "aibatjardem",
    "contributors": [
        "samiyev (original author, https://github.com/imfozilbek/agentsoul)"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aibatjardem/agentsoul.git"
    },
    "bugs": {
        "url": "https://github.com/aibatjardem/agentsoul/issues"
    },
    "homepage": "https://github.com/aibatjardem/agentsoul#readme",
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "commander": "^12.0.0",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.6.0"
    },
    "private": true
}
